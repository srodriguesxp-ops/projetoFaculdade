# SQL Server (SSMS)
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=MisterMoney
MSSQL_WINDOWS_AUTH=true
MSSQL_ENCRYPT=false

# Preencher apenas se MSSQL_WINDOWS_AUTH=false
MSSQL_USER=
MSSQL_PASSWORD=

# URL JDBC completa usada pelo backend Java (sobrescreve as variáveis acima)
# Windows integrado:
MSSQL_JDBC_URL=jdbc:sqlserver://localhost:1433;databaseName=MisterMoney;integratedSecurity=true;encrypt=false;trustServerCertificate=true
# NTLM (alternativa):
# MSSQL_JDBC_URL=jdbc:sqlserver://HOST:1433;databaseName=MisterMoney;authenticationScheme=NTLM;user=DOMINIO\USUARIO;password=SENHA;encrypt=false;trustServerCertificate=true

# Carga inicial de desenvolvimento
MSSQL_SEED_ENABLED=true

# URL da API Java quando o front Next.js for conectado
API_BASE_URL=http://localhost:8081
